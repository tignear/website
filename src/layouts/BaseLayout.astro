---
import '../styles/global.css';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  type?: 'website' | 'article';
}

const {
  title = site.title,
  description = site.description,
  canonical = Astro.url.pathname,
  type = 'website',
} = Astro.props;
const canonicalUrl = new URL(canonical, site.url);
const path = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
const schema = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'Article' : 'WebSite',
  name: title,
  description,
  url: canonicalUrl.toString(),
  author: { '@type': 'Person', name: site.author },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171522" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header shell">
      <nav class="nav" aria-label="メインナビゲーション">
        <a class="brand" href="/">{site.name}</a>
        <ul class="nav-links">
          <li><a href="/#notes">Notes</a></li>
          <li><a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>About</a></li>
        </ul>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>© {new Date().getFullYear()} {site.author}</p>
        <p><a href={site.social.github} rel="me external">GitHub ↗</a></p>
      </div>
    </footer>
  </body>
</html>
